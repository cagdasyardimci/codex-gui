{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex GUI Beta",
  "version": "0.1.0",
  "identifier": "local.codexgui.tauri.beta",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Codex GUI Beta", "width": 1040, "height": 720, "create": false }
    ],
    "security": {
      "capabilities": ["diagnostic", "workspace"],
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; img-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Codex GUI diagnostic shell",
    "license": "MIT",
    "resources": {
      "../../LICENSE.md": "notices/LICENSE.md",
      "../frontend/node_modules/@tauri-apps/api/LICENSE-MIT": "notices/Tauri-MIT.txt",
      "../frontend/node_modules/svelte/LICENSE.md": "notices/Svelte-MIT.md",
      "../frontend/src/assets/Inter-LICENSE.txt": "notices/Inter-OFL.txt",
      "../frontend/dist/frontend-licenses.md": "notices/frontend-licenses.md"
    },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
