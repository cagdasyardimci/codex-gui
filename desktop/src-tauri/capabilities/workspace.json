{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "Local main window workspace selection and scoped reads",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-pick-workspace",
    "allow-workspace-snapshot",
    "allow-search-project-paths",
    "allow-pick-composer-attachments",
    "allow-paste-composer-image",
    "allow-remove-composer-attachment",
    "allow-load-composer-image",
    "allow-reuse-composer-attachment",
    "allow-copy-transcript-row",
    "allow-check-transcript-images",
    "allow-render-transcript-markdown",
    "allow-load-transcript-image",
    "allow-load-transcript-attachment",
    "allow-open-transcript-link",
    "allow-navigate-workspace",
    "allow-checkout-changes",
    "allow-checkout-patch",
    "allow-subscribe-workspace",
    "allow-next-workspace-update"
  ]
}
