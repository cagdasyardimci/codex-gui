{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "Local main window workspace selection and scoped reads",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-pick-workspace",
    "allow-workspace-snapshot",
    "allow-search-project-paths",
    "allow-change-file-tools",
    "allow-browse-project-files",
    "allow-read-file-tab",
    "allow-edit-file-tab",
    "allow-start-file-search",
    "allow-read-file-search",
    "allow-cancel-file-search",
    "allow-open-file-search-hit",
    "allow-pick-composer-attachments",
    "allow-composer-context-catalog",
    "allow-read-project-context",
    "allow-add-composer-context",
    "allow-paste-composer-image",
    "allow-remove-composer-attachment",
    "allow-load-composer-image",
    "allow-read-composer-annotations",
    "allow-save-composer-annotations",
    "allow-reuse-composer-attachment",
    "allow-copy-transcript-row",
    "allow-check-transcript-images",
    "allow-render-transcript-markdown",
    "allow-load-transcript-image",
    "allow-load-transcript-attachment",
    "allow-open-transcript-link",
    "allow-reveal-inspector-attachment",
    "allow-navigate-workspace",
    "allow-read-archive",
    "allow-prepare-chat-deletion",
    "allow-open-message-search",
    "allow-read-message-search-page",
    "allow-open-inspector-source",
    "allow-read-inspector-source-detail",
    "allow-read-child-history",
    "allow-execute-slash-command",
    "allow-open-sent-prompt",
    "allow-reveal-sidebar-project",
    "allow-checkout-changes",
    "allow-count-chat-changes",
    "allow-checkout-patch",
    "allow-subscribe-workspace",
    "allow-next-workspace-update"
  ]
}
