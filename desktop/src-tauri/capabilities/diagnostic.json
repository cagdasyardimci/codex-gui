{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "diagnostic",
  "description": "Fixture actions for the local diagnostic window",
  "windows": ["main"],
  "permissions": [
    "allow-stream-fixture",
    "allow-verification-mode",
    "allow-verify-fixture-result",
    "allow-verify-media-result",
    "allow-verify-history-result",
    "allow-verify-account-result",
    "allow-verify-windows-setup-result",
    "allow-verify-turn-result",
    "allow-verify-diff-result",
    "allow-change-workspace-fixture"
  ]
}
